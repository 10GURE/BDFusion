          <mxGeometry x="480" y="980" width="640" height="280" as="geometry" />
        </mxCell>
        <mxCell id="fusion_title" value="&lt;b&gt;Fusion Attention (Cross-Attention)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RGB tokens attend to IR tokens, 融合两个模态的退化信息&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="620" y="990" width="360" height="40" as="geometry" />
        </mxCell>
        
        <!-- Q, K, V -->
        <mxCell id="fusion_q" value="&lt;b&gt;Q&lt;/b&gt;&lt;br&gt;Linear(rgb_tokens)&lt;br&gt;[B, 4, 256]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="510" y="1040" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fusion_k" value="&lt;b&gt;K&lt;/b&gt;&lt;br&gt;Linear(ir_tokens)&lt;br&gt;[B, 4, 256]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="735" y="1040" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fusion_v" value="&lt;b&gt;V&lt;/b&gt;&lt;br&gt;Linear(ir_tokens)&lt;br&gt;[B, 4, 256]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="960" y="1040" width="130" height="60" as="geometry" />
        </mxCell>
        
        <!-- Attention Computation -->
        <mxCell id="attn_compute" value="&lt;b&gt;Attention&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Attn = Softmax(Q @ K&lt;sup&gt;T&lt;/sup&gt; / √d)&lt;br&gt;ir_info = Attn @ V&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="680" y="1130" width="160" height="60" as="geometry" />
        </mxCell>
        
        <!-- Residual -->
        <mxCell id="residual" value="&lt;b&gt;Residual Add&lt;/b&gt;&lt;br&gt;fused = rgb_tokens + ir_info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="680" y="1200" width="160" height="45" as="geometry" />
        </mxCell>
        
        <!-- Fusion Arrows -->
        <mxCell id="fusion_q_arr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="fusion_q" target="attn_compute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fusion_k_arr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="fusion_k" target="attn_compute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fusion_v_arr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="fusion_v" target="attn_compute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="attn_to_res" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="attn_compute" target="residual">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- ==================== Final Output ==================== -->
        <mxCell id="final_output" value="&lt;b&gt;task_tokens&lt;/b&gt;&lt;br&gt;[B, 4, 256]&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;4个 token 描述整体退化类型&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#00ff00;strokeColor=#006600;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="710" y="1290" width="180" height="80" as="geometry" />
        </mxCell>
        
        <!-- Final Arrows -->
        <mxCell id="rgb_to_fusion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="rgb_tokens_out" target="fusion_q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="960" />
              <mxPoint x="575" y="960" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ir_to_fusion_k" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="ir_tokens_out" target="fusion_k">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1155" y="780" />
              <mxPoint x="870" y="780" />
              <mxPoint x="870" y="1010" />
              <mxPoint x="800" y="1010" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ir_to_fusion_v" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;" edge="1" parent="1" source="ir_tokens_out" target="fusion_v">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1155" y="780" />
              <mxPoint x="1155" y="1010" />
              <mxPoint x="1025" y="1010" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="res_to_final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="residual" target="final_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- ==================== Legend ==================== -->
        <mxCell id="legend_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="90" width="180" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;图例 Legend&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="95" width="100" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1410" y="120" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1_text" value="RGB 相关" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="120" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1410" y="145" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2_text" value="IR 相关" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="145" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1410" y="170" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3_text" value="多尺度特征" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="170" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1410" y="195" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4_text" value="MLP 投影" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="195" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1410" y="220" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg5_text" value="池化/注意力" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="220" width="80" height="20" as="geometry" />
        </mxCell>
        
        <mxCell id="leg6" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1410" y="245" width="30" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg6_text" value="特征融合" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1450" y="245" width="80" height="20" as="geometry" />
        </mxCell>
        
        <!-- ==================== Notes ==================== -->
        <mxCell id="notes_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1040" width="370" height="200" as="geometry" />
        </mxCell>
        <mxCell id="notes_title" value="&lt;b&gt;关键设计说明&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1045" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="notes_content" value="&lt;div style=&quot;text-align: left; font-size: 10px;&quot;&gt;&#xa;&lt;b&gt;1. 双流独立编码&lt;/b&gt;&lt;br&gt;RGB/IR 各有独立的 encoder，可学习模态特有的退化特征&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;2. 多尺度特征&lt;/b&gt;&lt;br&gt;3×3/5×5/7×7 卷积捕获不同尺度的退化（噪声/模糊/雾霾）&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;3. Cross-Attention 融合&lt;/b&gt;&lt;br&gt;RGB 作为 Query，IR 作为 Key/Value&lt;br&gt;让 RGB 特征能够查询 IR 中的补充信息&lt;br&gt;&lt;br&gt;&#xa;&lt;b&gt;4. 输出 4 个 Tokens&lt;/b&gt;&lt;br&gt;每个 token 256 维，共同描述整体退化类型&#xa;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1070" width="350" height="160" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
